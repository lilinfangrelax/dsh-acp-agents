{
  "name": "dsh-acp-agents",
  "version": "1.0.0",
  "description": "Connect DeepSeek Harness to the coding agents already installed on your machine over the Agent Client Protocol (ACP): local detection, the official ACP Registry, native chat routing and subagent delegation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilinfangrelax/dsh-acp-agents.git"
  },
  "homepage": "https://github.com/lilinfangrelax/dsh-acp-agents#readme",
  "bugs": {
    "url": "https://github.com/lilinfangrelax/dsh-acp-agents/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "acp",
    "agent-client-protocol",
    "claude-code",
    "codex",
    "cursor",
    "opencode"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "manager.js",
    "acp-client.js",
    "acp-options.js",
    "workspace.js",
    "chat-provider.js",
    "catalog.js",
    "store.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run-tests.mjs && node test/chat-provider-test.mjs && node test/manager-test.mjs && node test/client-render-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
